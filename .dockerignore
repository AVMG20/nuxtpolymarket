# Dependencies and build output are produced inside the image. Without this,
# `COPY . .` overwrites the Alpine node_modules installed above with the host's
# (on macOS, darwin binaries) and breaks the build.
node_modules
.nuxt
.output
dist

.git
.github
.idea
.claude
.agents

.env
.env.*

.DS_Store

# Not consumed by the image build — keeping them out of the context means
# edits to them don't invalidate the COPY . . layer and rerun the Nuxt build.
docs
test
scripts
AGENTS.md
CLAUDE.md
README.md
LICENSE
renovate.json
skills-lock.json
vitest.config.ts
Dockerfile
docker-compose.yml
.dockerignore

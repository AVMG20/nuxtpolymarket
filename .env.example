DATABASE_URL=postgresql://polynux:polynux@localhost:5432/polynux
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-string
BETTER_AUTH_URL=http://localhost:3000

# Bugsink uses the Sentry SDK protocol. One variable feeds both the browser and
# the server SDK: the NUXT_PUBLIC_ prefix is what lets Nuxt override it at
# runtime, so the deployed container picks it up without a rebuild. Leave empty
# to run without error tracking.
NUXT_PUBLIC_SENTRY_DSN=http://e353c021e3c7497bbeced6f73f78db40@localhost:3000/sentry/1

# Alias for the same thing, under the name Argus issues its DSNs with. Set
# either one. `bun run sentry:check` posts a test event and tells you whether it
# landed — both SDKs swallow transport errors, so nothing else will.
PROJECT_DSN=

# Set to true to make all Xeno grow/breed times 1 second (dev testing only)
XENO_DEV=false

# Used by scripts/generate-hack-voice-lines.ts to generate missing RELAY VO lines
ELEVENLABS_API_KEY=

# Used by scripts/generate-hack-images.ts to generate missing HackOps images
OPENAI_API_KEY=

# AI assistant (server-side only). Its model and system prompt are managed by
# the @preset/poly-nuxt OpenRouter preset.
OPENROUTER_API_KEY=
